# EventFlow AI Environment Configuration

# AI Settings (Gemma 4 via Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL_ID=gemini-2.5-flash

# Transactional Email (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=EventFlow AI <onboarding@resend.dev>

# Email Mode: set to "false" to send live transactional emails, or "true" for simulation
SIMULATION_MODE=true

# Host & URLs
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./eventflow.db
